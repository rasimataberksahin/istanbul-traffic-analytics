# Copy this file to .env and replace the password before starting the database.
POSTGRES_DB=istanbul_traffic
POSTGRES_USER=traffic_admin
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55442
DATABASE_URL=postgresql://traffic_admin:change-me@127.0.0.1:55442/istanbul_traffic
ConnectionStrings__Traffic=Host=127.0.0.1;Port=55442;Database=istanbul_traffic;Username=traffic_admin;Password=change-me
Admin__ApiKey=replace-with-a-long-random-value
# Host ports of the full stack (docker compose up)
API_PORT=5088
WEB_PORT=3000
